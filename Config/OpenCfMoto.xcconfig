// SPDX-License-Identifier: AGPL-3.0-or-later
// Shared build settings. Do NOT put your team ID here — create Config/Local.xcconfig (git-ignored):
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   BUNDLE_ID_PREFIX = com.yourname
//   OCM_FLAVOR = free        // only if you use a free Personal Team (no Hotspot / Wi-Fi info entitlements)
//
// The TestFlight workflow (.github/workflows/testflight.yml) writes its own Local.xcconfig with the
// same keys plus the OCM_CODE_SIGN_* / OCM_PROFILE_* signing overrides below.
//
BUNDLE_ID_PREFIX = com.example
DEVELOPMENT_TEAM =
APP_GROUP_ID = group.$(BUNDLE_ID_PREFIX).opencfmoto

// Build flavor:
//   full — paid Apple Developer Program: the app joins the bike Wi-Fi itself (Hotspot Configuration)
//          and can read the current SSID (Access WiFi Information).
//   free — free Personal Team: no Hotspot entitlements; the rider joins the bike Wi-Fi in Settings.
OCM_FLAVOR = full
OCM_SWIFT_FLAGS_full =
OCM_SWIFT_FLAGS_free = OCM_NO_HOTSPOT

// Signing (project.yml uses these for both targets). Defaults = Xcode's automatic signing with your
// development certificate, as before. Only the TestFlight workflow overrides them (Manual, Apple
// Distribution and the App Store profiles it creates); you normally leave them alone.
OCM_CODE_SIGN_STYLE = Automatic
OCM_CODE_SIGN_IDENTITY = Apple Development
OCM_PROFILE_APP =
OCM_PROFILE_MIRROR =

#include? "Local.xcconfig"
