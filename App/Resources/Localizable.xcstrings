    "Everything on the iPhone screen is sent to the dash, whatever app is open.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que aparece en la pantalla del iPhone se envía al tablero, sea cual sea la app abierta."
