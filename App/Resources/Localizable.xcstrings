      }
    },
    "Sharper": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más nítido"
          }
        }
      }
    },
    "Sharper — more data": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más nítido: más datos"
          }
        }
      }
    },
    "Show Apple Music on the dash": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar Apple Music en el tablero"
          }
        }
      }
    },
    "Show dash": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver el tablero"
          }
        }
      }
    },
    "Show onboarding again": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar de nuevo la introducción"
          }
        }
      }
    },
    "Show password": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar contraseña"
          }
        }
      }
    },
    "Show the whole iPhone screen on the dash": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra toda la pantalla del iPhone en el tablero"
          }
        }
      }
    },
    "Shows About & credits": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra Acerca de y créditos"
          }
        }
      }
    },
    "Shows the dash. Tap or drag it like the dash touchscreen; the keypad works with VoiceOver.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el tablero. Tócalo o arrástralo como la pantalla táctil del tablero; el mando funciona con VoiceOver."
          }
        }
      }
    },
    "Shows the route preview": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la vista previa de la ruta"
          }
        }
      }
    },
    "Skip for now": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitir por ahora"
          }
        }
      }
    },
    "Slate": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizarra"
          }
        }
      }
    },
    "Smooth": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluido"
          }
        }
      }
    },
    "Smooth — 30 fps (most battery)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluido: 30 fps (más consumo de batería)"
          }
        }
      }
    },
    "Smoother": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más suave"
          }
        }
      }
    },
    "Smoother — less data/latency": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más fluido: menos datos/latencia"
          }
        }
      }
    },
    "Snappy singles. Discrete hold / Select ×2 usually don't exist; ▲/▼ only work with Volume buttons on (a hard ▲▲ / ▼▼ flick = Back / menu). Dash touch and the phone cover the rest.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsaciones simples inmediatas. Mantener / Seleccionar ×2 no suelen existir; ▲/▼ solo funcionan con los botones de volumen activados (un ▲▲ / ▼▼ rápido = Atrás / menú). El táctil del tablero y el teléfono cubren el resto."
          }
        }
      }
    },
    "Source code": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código fuente"
          }
        }
      }
    },
    "Speed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocidad"
          }
        }
      }
    },
    "Speed and distance come from the phone's GPS (the bike doesn't share telemetry over the dash link). Keep a clear view of the sky for best accuracy.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La velocidad y la distancia salen del GPS del teléfono (la moto no comparte telemetría por el enlace del tablero). Para más precisión, deja el teléfono con el cielo despejado a la vista."
          }
        }
      }
    },
    "Speed limit %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite de velocidad %@"
          }
        }
      }
    },
    "Start recording": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar a grabar"
          }
        }
      }
    },
    "Start riding": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar a rodar"
          }
        }
      }
    },
    "Start screen broadcast": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar la transmisión de pantalla"
          }
        }
      }
    },
    "Starting Apple Music from the dash gives these buttons to the music until you pause it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si pones Apple Music desde el tablero, estos botones pasan a la música hasta que la pauses."
          }
        }
      }
    },
    "Startup & recovery": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicio y recuperación"
          }
        }
      }
    },
    "Stay here": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedarme aquí"
          }
        }
      }
    },
    "Step %lld of %lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paso %lld de %lld"
          }
        }
      }
    },
    "Step 1 · Connect the bike": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paso 1 · Conecta la moto"
          }
        }
      }
    },
    "Step 2 · Start the screen broadcast": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paso 2 · Inicia la transmisión de pantalla"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener"
          }
        }
      }
    },
    "Stop & save": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener y guardar"
          }
        }
      }
    },
    "Stopped": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenido"
          }
        }
      }
    },
    "Stops the dash link and everything it projects": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene el enlace con el tablero y todo lo que proyecta"
          }
        }
      }
    },
    "Stops the iPhone from auto-locking while the dash is linked, so the map keeps streaming at full quality.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que el iPhone se bloquee solo mientras el tablero está vinculado, así el mapa sigue llegando a plena calidad."
          }
        }
      }
    },
    "Stretch": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estirar"
          }
        }
      }
    },
    "Stretch — fills, slight distortion": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estirar: llena la pantalla con algo de distorsión"
          }
        }
      }
    },
    "Switch the dash to Mirror": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el tablero a Espejo"
          }
        }
      }
    },
    "Tap the button, choose OpenCfMoto Mirror, then Start Broadcast.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón, elige OpenCfMoto Mirror y luego Iniciar transmisión."
          }
        }
      }
    },
    "Tap, drag and long-press the picture like the dash touchscreen. The keypad works like the handlebar buttons.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca, arrastra y mantén presionada la imagen como la pantalla táctil del tablero. El mando funciona como los botones del manillar."
          }
        }
      }
    },
    "Teach my handlebar": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enseñar mi manillar"
          }
        }
      }
    },
    "That file is not a text file.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese archivo no es de texto."
          }
        }
      }
    },
    "That file is too large.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese archivo es demasiado grande."
          }
        }
      }
    },
    "The app closed unexpectedly last time. The details are included when you share the logs or report a problem.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se cerró inesperadamente la última vez. Los detalles se incluyen al compartir los registros o informar de un problema."
          }
        }
      }
    },
    "The canvas is the picture size this dash asked for on the last connection.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lienzo es el tamaño de imagen que pidió este tablero en la última conexión."
          }
        }
      }
    },
    "The dash can't control the iPhone: touches and handlebar buttons don't reach mirrored apps.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tablero no puede controlar el iPhone: los toques y los botones del manillar no llegan a las apps duplicadas."
          }
        }
      }
    },
    "The dash stays live.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tablero sigue en vivo."
          }
        }
      }
    },
    "The dash stays live. If you switch the bike off, it reconnects by itself.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tablero sigue en vivo. Si apagas la moto, se reconecta sola."
          }
        }
      }
    },
    "The dash stopped answering after 20 reconnect attempts. Check that the bike is on and the dash shows MotoPlay, then tap Connect.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tablero dejó de responder tras 20 intentos de reconexión. Comprueba que la moto está encendida y que el tablero muestra MotoPlay, y toca Conectar."
          }
        }
      }
    },
    "The dash talks to your iPhone over the bike's Wi-Fi, so iOS asks for Local Network access. The prompt can also appear the first time OpenCfMoto connects — tap Allow when it does.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tablero habla con tu iPhone por el Wi-Fi de la moto, así que iOS pide acceso a la red local. El aviso también puede aparecer la primera vez que OpenCfMoto se conecta: toca Permitir cuando salga."
          }
        }
      }
    },
    "The distance and time logged so far are thrown away. Nothing is saved — automatic logging then starts a new ride.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descartan la distancia y el tiempo registrados hasta ahora. No se guarda nada; después, el registro automático empieza un viaje nuevo."
          }
        }
      }
    },
    "The distance and time recorded so far are thrown away. Nothing is saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descartan la distancia y el tiempo grabados hasta ahora. No se guarda nada."
          }
        }
      }
    },
    "The report includes the app version, the active bike profile, the link state and the recent log.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El informe incluye la versión de la app, el perfil de la moto activa, el estado del enlace y el registro reciente."
          }
        }
      }
    },
    "The template needs {z}, {x} and {y} and must start with https://": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La plantilla necesita {z}, {x} y {y} y debe empezar por https://"
          }
        }
      }
    },
    "Then start the screen broadcast in step 2.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después inicia la transmisión de pantalla en el paso 2."
          }
        }
      }
    },
    "This app comes with ABSOLUTELY NO WARRANTY, to the extent permitted by applicable law.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app se ofrece SIN NINGUNA GARANTÍA, en la medida en que lo permita la ley aplicable."
          }
        }
      }
    },
    "This app renders and encodes live video — it always draws power and warms the phone. Keep it on the bike's USB charger and use Pocket mode while riding (the dash stays live). Auto lowers the frame rate when the phone gets hot.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app dibuja y codifica video en vivo: siempre consume energía y calienta el teléfono. Tenlo en el cargador USB de la moto y usa el Modo bolsillo mientras vas en la moto (el tablero sigue en vivo). Auto baja los fps cuando el teléfono se calienta."
          }
        }
      }
    },
    "This bike is no longer in the garage.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta moto ya no está en el garaje."
          }
        }
      }
    },
    "This build can't join Wi-Fi networks by itself. When you connect, OpenCfMoto shows the bike's Wi-Fi name and password so you can join it in Settings ▸ Wi-Fi.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión no puede conectarse sola a redes Wi-Fi. Al conectar, OpenCfMoto muestra el nombre y la contraseña del Wi-Fi de la moto para que te conectes en Ajustes ▸ Wi-Fi."
          }
        }
      }
    },
    "This forgets its pairing, photo and settings. You can re-scan the dash QR or enter Wi-Fi again later.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se olvidan su emparejamiento, su foto y sus ajustes. Puedes volver a escanear el QR o introducir el Wi-Fi más tarde."
          }
        }
      }
    },
    "This iPhone does not allow camera access (Screen Time or a profile). Import the QR from a photo or enter the Wi-Fi manually.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone no permite el acceso a la cámara (Tiempo de uso o un perfil). Importa el QR desde una foto o introduce el Wi-Fi manualmente."
          }
        }
      }
    },
    "Throws this recording away without saving it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarta esta grabación sin guardarla"
          }
        }
      }
    },
    "Tile URL template": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantilla de URL de teselas"
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo"
          }
        }
      }
    },
    "Timing is shared by all bikes and applies on the next press.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tiempos son comunes a todas las motos y se aplican en la siguiente pulsación."
          }
        }
      }
    },
    "To end the screen broadcast, tap the red indicator in the status bar or use Control Center.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para terminar la transmisión de pantalla, toca el indicador rojo de la barra de estado o usa el Centro de control."
          }
        }
      }
    },
    "Top": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba"
          }
        }
      }
    },
    "Top %@ · bottom %@ · left %@ · right %@ px": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba %@ · abajo %@ · izquierda %@ · derecha %@ px"
          }
        }
      }
    },
    "Top %@ · bottom %@ · left %@ · right %@ px (profile default)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba %@ · abajo %@ · izquierda %@ · derecha %@ px (valor del perfil)"
          }
        }
      }
    },
    "Touch dashes (800NK Advanced, 800MT): just tap the dash. Handlebar control is meant for non-touch dashes such as the 450SR.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tableros táctiles (800NK Advanced, 800MT): toca el tablero. El control por manillar está pensado para tableros no táctiles como la 450SR."
          }
        }
      }
    },
    "Track preview": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa del track"
          }
        }
      }
    },
    "Tries the bike again right away instead of waiting for the automatic retry": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a intentarlo con la moto ahora mismo en lugar de esperar al reintento automático"
          }
        }
      }
    },
    "Trip computer": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Computadora de viaje"
          }
        }
      }
    },
    "Trip end": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fin del viaje"
          }
        }
      }
    },
    "Trip has no GPS points": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El viaje no tiene puntos GPS"
          }
        }
      }
    },
    "Trip start": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicio del viaje"
          }
        }
      }
    },
    "Trips": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Viajes"
          }
        }
      }
    },
    "Turn it on in Settings ▸ OpenCfMoto ▸ Local Network, or the dash can't be reached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo en Ajustes ▸ OpenCfMoto ▸ Red local; si no, no se puede llegar al tablero."
          }
        }
      }
    },
    "Turn it on in Settings ▸ OpenCfMoto ▸ Location (While Using the App, Precise Location on).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívala en Ajustes ▸ OpenCfMoto ▸ Ubicación («Cuando se use la app», con Ubicación exacta activada)."
          }
        }
      }
    },
    "Turn on": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar"
          }
        }
      }
    },
    "Turn on Disable touchscreen if handlebar buttons do nothing: the dash UI then runs in focus/knob mode. Force touchscreen is for a touch panel on a focus/knob profile (e.g. 1000 MT-X; unlock the bike's own touch lock if needed). Video, fit and touch settings apply on the next connect — Stop first if you're already projecting.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Desactivar pantalla táctil si los botones del manillar no hacen nada: la interfaz del tablero pasa a modo foco/mando. Forzar pantalla táctil es para un panel táctil con un perfil de foco/mando (p. ej. la 1000 MT-X; desbloquea el bloqueo táctil de la moto si hace falta). El video, el ajuste de pantalla y las opciones táctiles se aplican en la próxima conexión: detén la proyección primero si ya está en marcha."
          }
        }
      }
    },
    "Turn on Wi-Fi": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el Wi-Fi"
          }
        }
      }
    },
    "Turn on the phone media remote to test the buttons.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el mando multimedia del teléfono para probar los botones."
          }
        }
      }
    },
    "Turn the bike on and open MotoPlay / EasyConnect on the dash so it shows the pairing QR, then scan it. Bikes without a QR (e.g. Benelli TRK): enter the Wi-Fi name and password instead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enciende la moto y abre MotoPlay/EasyConnect en el tablero para que muestre el QR de emparejamiento, y escanéalo. Motos sin QR (p. ej. Benelli TRK): introduce el nombre del Wi-Fi y la contraseña."
          }
        }
      }
    },
    "Turn the bike on, then tap Connect on the home screen. During a ride keep OpenCfMoto open: Pocket mode keeps the iPhone screen dark while the dash stays live. It starts by itself 5 s after Connect or Go.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enciende la moto y toca Conectar en la pantalla de inicio. Durante el viaje mantén OpenCfMoto abierta: el Modo bolsillo deja la pantalla del iPhone en negro mientras el tablero sigue en vivo. Se activa solo 5 s después de Conectar o Ir."
          }
        }
      }
    },
    "Type a place name": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe el nombre de un lugar"
          }
        }
      }
    },
    "Type a place to search on the map": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un lugar para buscar en el mapa."
          }
        }
      }
    },
    "Units": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unidades"
          }
        }
      }
    },
    "Unknown": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconocido"
          }
        }
      }
    },
    "Up": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba"
          }
        }
      }
    },
    "Use Legacy for CFDL16 / 450SR-style non-touch dashes if Auto picks the wrong bike. 800NK Adv = CFDL26 touch 720×712. Applies on the next connect (Stop first if projecting).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Legacy para tableros no táctiles estilo CFDL16/450SR si Auto elige la moto equivocada. 800NK Adv = CFDL26 táctil 720×712. Se aplica en la próxima conexión (detén la proyección primero si está en marcha)."
          }
        }
      }
    },
    "Use at your own risk. Set your route before you ride and never interact with the phone or the dash while riding.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Úsalo bajo tu propia responsabilidad. Fija la ruta antes de salir y nunca toques el teléfono ni el tablero mientras manejas."
          }
        }
      }
    },
    "Use the phone media remote": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar el mando multimedia del teléfono"
          }
        }
      }
    },
    "Use the phone media remote?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Usar el mando multimedia del teléfono?"
          }
        }
      }
    },
    "Use this bike": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar esta moto"
          }
        }
      }
    },
    "Version %@  ·  build %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versión %@  ·  compilación %@"
          }
        }
      }
    },
    "Video quality": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calidad de video"
          }
        }
      }
    },
    "Video quality, fit, power, bike profile and button mapping are kept per bike; everything else is shared by all bikes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La calidad de video, el ajuste de pantalla, la energía, el perfil y los botones se guardan por moto; el resto es común a todas."
          }
        }
      }
    },
    "View LICENSE & NOTICE": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver LICENSE y NOTICE"
          }
        }
      }
    },
    "Viewpoint": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirador"
          }
        }
      }
    },
    "Voice prompts": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indicaciones de voz"
          }
        }
      }
    },
    "Volume buttons ▲/▼ (experimental)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Botones de volumen ▲/▼ (experimental)"
          }
        }
      }
    },
    "Waiting for GPS…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando al GPS…"
          }
        }
      }
    },
    "Waiting for the dash · reconnects by itself": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando el tablero · se reconecta sola"
          }
        }
      }
    },
    "Warnings": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisos"
          }
        }
      }
    },
    "Welcome to OpenCfMoto": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te damos la bienvenida a OpenCfMoto"
          }
        }
      }
    },
    "What went wrong?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué ha fallado?"
          }
        }
      }
    },
    "When the app opens, connect to the active bike automatically. iOS can't scan for Wi-Fi, so it simply tries once.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir la app, conecta automáticamente con la moto activa. iOS no puede buscar redes Wi-Fi, así que simplemente lo intenta una vez."
          }
        }
      }
    },
    "Which buttons does this bike actually send? Mark a source Absent if it never reaches the phone, or leave it Unknown and OpenCfMoto finds out by itself.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué botones envía realmente esta moto? Marca como Ausente lo que nunca llegue al teléfono, o déjalo en Desconocido y OpenCfMoto lo averigua solo."
          }
        }
      }
    },
    "While Apple Music plays, the bike's ◀ ▶ ★ buttons control the music. With the phone media remote on, pause the song with ★ to give them back to the dash.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras suena Apple Music, los botones ◀ ▶ ★ de la moto controlan la música. Con el mando multimedia del teléfono activado, pausa la canción con ★ para devolvérselos al tablero."
          }
        }
      }
    },
    "While mirroring, hold the phone this way so the dash fills. Match dash follows the dash's shape (wide screen → landscape). iOS can't rotate the phone for you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras duplicas, sujeta el teléfono así para que el tablero se llene. Igual que el tablero sigue su forma (pantalla ancha → horizontal). iOS no puede girar el teléfono por ti."
          }
        }
      }
    },
    "While on, the bike's ◀ ▶ ★ buttons move the focus, select and open the menu of the dash UI. Turn it off if you want them to control your music again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras esté activado, los botones ◀ ▶ ★ de la moto mueven el foco, seleccionan y abren el menú del tablero. Desactívalo si quieres que vuelvan a controlar tu música."
          }
        }
      }
    },
    "While using the app": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras se usa la app"
          }
        }
      }
    },
    "Wi-Fi": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi"
          }
        }
      }
    },
    "Wi-Fi name (SSID)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de Wi-Fi (SSID)"
          }
        }
      }
    },
    "Wi-Fi name copied": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de Wi-Fi copiado"
          }
        }
      }
    },
    "Wi-Fi passwords and serial numbers will appear in shared logs and problem reports. Only turn this on for a private debugging session.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las contraseñas Wi-Fi y los números de serie aparecerán en los registros e informes compartidos. Actívalo solo para una sesión de depuración privada."
          }
        }
      }
    },
    "Year (optional)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Año (opcional)"
          }
        }
      }
    },
    "You may use, study, share, and modify this app under the AGPL. If you redistribute a modified version (including as a network service), you must offer the complete corresponding source under the same license.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes usar, estudiar, compartir y modificar esta aplicación según la AGPL. Si redistribuyes una versión modificada (incluso como servicio de red), debes ofrecer el código fuente correspondiente completo bajo la misma licencia."
          }
        }
      }
    },
    "You're all set": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo listo"
          }
        }
      }
    },
    "Your left switch cluster": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu piña de mandos izquierda"
          }
        }
      }
    },
    "Your location draws the map and the turn-by-turn guidance on the dash and logs your rides on this iPhone. OpenCfMoto asks for “While Using the App”; during a ride it keeps working with the screen locked and iOS shows the location indicator.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación dibuja el mapa y la navegación giro a giro en el tablero y registra tus rutas en este iPhone. OpenCfMoto pide «Cuando se use la app»; durante una ruta sigue funcionando con la pantalla bloqueada e iOS muestra el indicador de ubicación."
          }
        }
      }
    },
    "Your own map and turn-by-turn guidance on Carbit / EasyConnect dashes (CFMoto MotoPlay and siblings).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu propio mapa y navegación giro a giro en tableros Carbit/EasyConnect (CFMoto MotoPlay y hermanos)."
          }
        }
      }
    },
    "Your position": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu posición"
          }
        }
      }
    },
    "Zoom %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom %@"
          }
        }
      }
    },
    "a quick tap of the OK / ★ start button": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "un toque rápido del botón OK / ★"
          }
        }
      }
    },
    "double-tap backward within a short window": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "doble toque hacia atrás en un margen corto"
          }
        }
      }
    },
    "double-tap forward within a short window": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "doble toque hacia adelante en un margen corto"
          }
        }
      }
    },
    "double-tap the OK / ★ button": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "doble toque en el botón OK / ★"
          }
        }
      }
    },
    "iOS can't see how long ★ is held, so this gesture never fires.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no puede ver cuánto tiempo se mantiene ★, así que este gesto nunca se dispara."
          }
        }
      }
    },
    "iOS gives these buttons to one app at a time: while this is on, music from other apps pauses (press ★ in the music app, or turn this off, to get it back). Pair the phone with the bike over Bluetooth first. Off in mirror mode. May not be accepted in App Store builds.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS da estos botones a una sola app a la vez: mientras esté activado, la música de otras apps se pausa (presiona ★ en la app de música o desactiva esto para recuperarla). Empareja antes el teléfono con la moto por Bluetooth. Desactivado en modo espejo. Puede que no se acepte en las versiones de la App Store."
          }
        }
      }
    },
    "iOS will ask when you first connect": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS lo pedirá la primera vez que te conectes"
          }
        }
      }
    },
    "press and hold the OK / ★ button": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "mantén presionado el botón OK / ★"
          }
        }
      }
    },
    "press and hold ▶ (track-key dashes only)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "mantén presionado ▶ (solo tableros con teclas de pista)"
          }
        }
      }
    },
    "press and hold ◀ (track-key dashes only)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "mantén presionado ◀ (solo tableros con teclas de pista)"
          }
        }
      }
    },
    "© 2026 the OpenCfMoto for iOS contributors · OpenCfMoto © 2026 Alexandru": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "© 2026 los colaboradores de OpenCfMoto para iOS · OpenCfMoto © 2026 Alexandru"
          }
        }
      }
    },
    "• Connect — joins the bike Wi-Fi and shows the OpenCfMoto map on the dash (becomes Stop while linked).\n• Map — search places, plan routes and load GPX tracks, even while connecting; the dash follows.\n• Mirror — shows the whole iPhone screen on the dash (no touch back).\n• Dash view & Controls — the live dash picture on the phone and the handlebar pad.\n• Pocket mode — a black screen that keeps the dash live with the iPhone unlocked. It starts by itself 5 s after Connect or Go; tap Stay here to keep using the phone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Conectar: se une al Wi-Fi de la moto y muestra el mapa de OpenCfMoto en el tablero (se convierte en Detener mientras está vinculado).\n• Mapa: busca lugares, planifica rutas y carga tracks GPX, también mientras se conecta; el tablero lo sigue.\n• Espejo: muestra toda la pantalla del iPhone en el tablero (sin control táctil).\n• Vista de tablero y Controles: la imagen del tablero en vivo en el teléfono y el mando del manillar.\n• Modo bolsillo: una pantalla negra que mantiene el tablero en vivo con el iPhone desbloqueado. Se activa solo 5 s después de Conectar o Ir; toca Quedarme aquí para seguir usando el teléfono."
          }
        }
      }
    },
    "• Connect — shows the bike Wi-Fi name and password to join in Settings ▸ Wi-Fi, then the OpenCfMoto map on the dash (becomes Stop while linked).\n• Map — search places, plan routes and load GPX tracks, even while connecting; the dash follows.\n• Mirror — shows the whole iPhone screen on the dash (no touch back).\n• Dash view & Controls — the live dash picture on the phone and the handlebar pad.\n• Pocket mode — a black screen that keeps the dash live with the iPhone unlocked. It starts by itself 5 s after Connect or Go; tap Stay here to keep using the phone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Conectar: te muestra el nombre y la contraseña del Wi-Fi de la moto para unirte en Ajustes ▸ Wi-Fi y luego el mapa de OpenCfMoto en el tablero (se convierte en Detener mientras está vinculado).\n• Mapa: busca lugares, planifica rutas y carga tracks GPX, también mientras se conecta; el tablero lo sigue.\n• Espejo: muestra toda la pantalla del iPhone en el tablero (sin control táctil).\n• Vista de tablero y Controles: la imagen del tablero en vivo en el teléfono y el mando del manillar.\n• Modo bolsillo: una pantalla negra que mantiene el tablero en vivo con el iPhone desbloqueado. Se activa solo 5 s después de Conectar o Ir; toca Quedarme aquí para seguir usando el teléfono."
          }
        }
      }
    },
    "▲/▼ volume rocker": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Balancín de volumen ▲/▼"
          }
        }
      }
    },
    "▶ right, or the ▼ volume press on non-touch dashes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "▶ derecha, o la pulsación de volumen ▼ en tableros no táctiles"
          }
        }
      }
    },
    "◀ left, or the ▲ volume press on non-touch dashes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "◀ izquierda, o la pulsación de volumen ▲ en tableros no táctiles"
          }
        }
      }
    },
    "◀/▶ = move the focus · ◀◀ = previous group · ▶▶ = menu · ★ = Select · ★★ = Back. Singles fire immediately (no lag waiting for ×2).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "◀/▶ = mover el foco · ◀◀ = grupo anterior · ▶▶ = menú · ★ = Seleccionar · ★★ = Atrás. Las pulsaciones simples se disparan al instante (sin esperar al ×2)."
          }
        }
      }
    },
    "◀/▶/★ track keys": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas de pista ◀/▶/★"
          }
        }
      }
    },
    "★ Save": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "★ Guardar"
          }
        }
      }
    },
    "★ moves the focus and ★★ selects. For dashes where only ★ reaches the phone; works best with a long double-tap delay.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "★ mueve el foco y ★★ selecciona. Para tableros en los que solo ★ llega al teléfono; funciona mejor con un retardo de doble pulsación largo."
          }
        }
      }
    },
    "★ only (one-button dashes)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo ★ (tableros de un botón)"
          }
        }
      }
    },
    "＋ Marker": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ Marcador"
          }
        }
      }
    }
  },
  "version": "1.0"
}
