            "value": "Rápido"
          }
        }
      }
    },
    "Fast = quickest roads. Fun = twistier. Circuit = go to a place and return home.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido = las carreteras más rápidas. Divertido = más revirado. Circuito = ir a un sitio y volver a casa."
