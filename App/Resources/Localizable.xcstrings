    "Mirror the whole iPhone screen": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicar toda la pantalla del iPhone"
          }
        }
      }
    },
    "Mirroring screen to dash": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicando la pantalla en el tablero"
          }
        }
      }
    },
    "Mirroring stops when the iPhone locks. To ride with the phone in your pocket, use Connect — the OpenCfMoto map.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La duplicación se detiene cuando el iPhone se bloquea. Para ir con el teléfono en el bolsillo, usa Conectar: el mapa de OpenCfMoto."
          }
        }
      }
    },
    "Model ID": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ID de modelo"
          }
        }
      }
    },
    "More": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más"
          }
        }
      }
    },
    "Moto Morini SoftAP (experimental)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moto Morini SoftAP (experimental)"
          }
        }
      }
    },
    "Moving time": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo en movimiento"
          }
        }
      }
    },
    "Name (e.g. Home)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre (p. ej. Casa)"
          }
        }
      }
    },
    "Navigate": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegar"
          }
        }
      }
    },
    "Navigate to parked bike": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir a la moto estacionada"
          }
        }
      }
    },
    "Navigate to saved place %@ (not set yet)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegar al lugar guardado %@ (aún sin configurar)"
          }
        }
      }
    },
    "Navigate: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegar: %@"
          }
        }
      }
    },
    "Next stop details": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detalles de la próxima parada"
          }
        }
      }
    },
    "Next: %@, %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguiente: %@, %@"
          }
        }
      }
    },
    "Night": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noche"
          }
        }
      }
    },
    "Night (dark)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noche (oscuro)"
          }
        }
      }
    },
    "No account, no ads, no tracking — your rides stay on this iPhone": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin anuncios, sin rastreo: tus rutas se quedan en este iPhone"
          }
        }
      }
    },
    "No bike paired yet — tap Connect to scan the dash QR": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay ninguna moto emparejada: toca Conectar para escanear el QR del tablero"
          }
        }
      }
    },
    "No bike paired yet — these settings apply to every bike you add.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay ninguna moto emparejada: estos ajustes se aplican a todas las motos que añadas."
          }
        }
      }
    },
    "No bikes yet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay motos"
          }
        }
      }
    },
    "No camera available": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna cámara disponible"
          }
        }
      }
    },
    "No dash answered on this Wi-Fi — if your iPhone is not on “%@”, join it in Settings ▸ Wi-Fi; otherwise keep the pairing QR open on the dash. Then tap Connect again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún tablero respondió en este Wi-Fi: si el iPhone no está en «%@», únete en Ajustes ▸ Wi-Fi; si lo está, mantén abierto el QR de emparejamiento en el tablero. Luego vuelve a tocar Conectar."
          }
        }
      }
    },
    "No log lines yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay líneas de registro."
          }
        }
      }
    },
    "No preset — shipped defaults / your custom map": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin preajuste: valores de fábrica o tu mapa personalizado"
          }
        }
      }
    },
    "No results": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin resultados"
          }
        }
      }
    },
    "No trips yet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay viajes"
          }
        }
      }
    },
    "None — the dash UI uses the whole screen": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguno: la interfaz usa todo el tablero"
          }
        }
      }
    },
    "Not asked yet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha pedido"
          }
        }
      }
    },
    "Not available": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible"
          }
        }
      }
    },
    "Not available on this device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible en este dispositivo."
          }
        }
      }
    },
    "Not connected yet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún sin conectar"
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no"
          }
        }
      }
    },
    "Nothing changes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambia nada"
          }
        }
      }
    },
    "Notifications appear on the dash too — turn on a Focus (for example Driving) to keep them private.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones también aparecen en el tablero: activa un modo de concentración (por ejemplo, Conducción) para mantenerlas en privado."
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Off — every release is a tap / ×2 (use with a long double-tap delay)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: cada suelta es una pulsación / ×2 (úsalo con un retardo de doble pulsación largo)"
          }
        }
      }
    },
    "Off — passwords and serials are redacted (recommended)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: las contraseñas y los números de serie se ocultan (recomendado)"
          }
        }
      }
    },
    "Off — use the bike profile (1000 MT-X stays focus/knob)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: usa el perfil de la moto (la 1000 MT-X sigue en modo foco/mando)"
          }
        }
      }
    },
    "Off — use the bike profile (touch dashes stay touch)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: usa el perfil de la moto (los tableros táctiles siguen siendo táctiles)"
          }
        }
      }
    },
    "Official CFMoto app is in the way": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación oficial de CFMoto está estorbando"
          }
        }
      }
    },
    "On — focus/knob UI so handlebar buttons work": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: interfaz de foco/rueda para que funcionen los botones del manillar"
          }
        }
      }
    },
    "On — passwords/serials stay in shared logs": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: las contraseñas y los números de serie se quedan en los registros compartidos"
          }
        }
      }
    },
    "On — press-and-hold can fire hold gestures": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: mantener presionado puede disparar los gestos largos"
          }
        }
      }
    },
    "On — touch UI (tap the dash)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: interfaz táctil (toca el tablero)"
          }
        }
      }
    },
    "One-tap Connect and automatic reconnects": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión con un toque y reconexión automática"
          }
        }
      }
    },
    "Only if the dash sends seek (hold) commands — most dashes don't.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo si el tablero envía órdenes de búsqueda (mantener): la mayoría no lo hace."
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes"
          }
        }
      }
    },
    "Open network — no password needed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Red abierta: no hace falta contraseña"
          }
        }
      }
    },
    "Open-source licenses": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Licencias de código abierto"
          }
        }
      }
    },
    "OpenCfMoto bike tuning": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes de moto de OpenCfMoto"
          }
        }
      }
    },
    "OpenCfMoto for Android (original project)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCfMoto para Android (proyecto original)"
          }
        }
      }
    },
    "OpenCfMoto for iOS (this app)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCfMoto para iOS (esta app)"
          }
        }
      }
    },
    "OpenCfMoto for iOS is a port of OpenCfMoto for Android by Alexandru Popa (zanderp). The dash protocol, bike profiles, navigation, trip logging and settings formats come from that project and its community.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCfMoto para iOS es una adaptación de OpenCfMoto para Android de Alexandru Popa (zanderp). El protocolo del tablero, los perfiles de moto, la navegación, el registro de viajes y los formatos de ajustes proceden de ese proyecto y de su comunidad."
          }
        }
      }
    },
    "OpenCfMoto has no account and sends nothing by itself: rides, logs and settings stay on this iPhone until you share them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCfMoto no tiene cuentas y no envía nada por su cuenta: viajes, registros y ajustes se quedan en este iPhone hasta que los compartas."
          }
        }
      }
    },
    "OpenCfMoto is an independent community project. It is not affiliated with, endorsed by, or sponsored by CFMOTO, Carbit, Apple, Google or any motorcycle brand that licenses EasyConnect-style dashes. CFMOTO, MotoPlay, EasyConn, Carbit and related marks are trademarks of their respective owners.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCfMoto es un proyecto comunitario independiente. No está afiliado, respaldado ni patrocinado por CFMOTO, Carbit, Apple, Google ni ninguna marca de motos que licencie tableros de tipo EasyConnect. CFMOTO, MotoPlay, EasyConn, Carbit y las marcas relacionadas son marcas comerciales de sus respectivos propietarios."
          }
        }
      }
    },
    "OpenCfMoto is free software: the complete source of this app is public, and so is the Android app it was ported from.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCfMoto es software libre: el código fuente completo de esta app es público, igual que el de la app de Android de la que procede."
          }
        }
      }
    },
    "OpenCfMoto joins the bike over Wi-Fi, but your phone's Wi-Fi is off.\n\nTurn it on in Control Center, then tap Connect again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCfMoto se conecta a la moto por Wi-Fi, pero el Wi-Fi del teléfono está apagado.\n\nActívalo en el Centro de control y vuelve a tocar Conectar."
          }
        }
      }
    },
    "OpenCfMoto learns which buttons this bike sends: ◀/▶/★ track keys and, with Volume buttons on, ▲/▼. After about 90 s of streaming with no ▲/▼ the rocker is marked absent automatically.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCfMoto aprende qué botones envía esta moto: las teclas de pista ◀/▶/★ y, con los botones de volumen activados, ▲/▼. Tras unos 90 s proyectando sin ▲/▼, el balancín se marca como ausente automáticamente."
          }
        }
      }
    },
    "OpenCfMoto log": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro de OpenCfMoto"
          }
        }
      }
    },
    "OpenCfMoto map data": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de mapa de OpenCfMoto"
          }
        }
      }
    },
    "OpenCfMoto needs Local Network access to talk to the dash over the bike Wi-Fi. Turn it on in Settings ▸ OpenCfMoto ▸ Local Network, then tap Connect again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCfMoto necesita acceso a la red local para hablar con el tablero por el Wi-Fi de la moto. Actívalo en Ajustes ▸ OpenCfMoto ▸ Red local y vuelve a tocar Conectar."
          }
        }
      }
    },
    "OpenCfMoto needs access to Media & Apple Music to show the song.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCfMoto necesita acceso a Multimedia y Apple Music para mostrar la canción."
          }
        }
      }
    },
    "OpenCfMoto problem report": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe de problema de OpenCfMoto"
          }
        }
      }
    },
    "OpenCfMoto shows its own map and turn-by-turn guidance on your motorcycle's dash, over the bike's Wi-Fi. It works with CFMoto MotoPlay and other Carbit / EasyConnect dashes that show a pairing QR.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCfMoto muestra su propio mapa y la navegación giro a giro en el tablero de tu moto, a través del Wi-Fi de la moto. Funciona con CFMoto MotoPlay y otros tableros Carbit/EasyConnect que muestran un QR de emparejamiento."
          }
        }
      }
    },
    "OpenCfMoto uses the camera only to scan the pairing QR on your dash; frames are never stored. Allow it in Settings, or import the QR from a photo or enter the Wi-Fi manually.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCfMoto usa la cámara solo para escanear el QR de emparejamiento del tablero; las imágenes nunca se guardan. Permítelo en Ajustes, o importa el QR desde una foto o introduce el Wi-Fi manualmente."
          }
        }
      }
    },
    "OpenCfMoto will play silent audio to become the iPhone's Now Playing app, so the bike's ◀ ▶ ★ buttons reach the dash. Music from other apps pauses while this is on. Experimental: not every dash sends these buttons.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCfMoto reproducirá audio silencioso para ser la app que suena en el iPhone (Now Playing); así los botones ◀ ▶ ★ de la moto llegan al tablero. La música de otras apps se pausa mientras esté activado. Experimental: no todos los tableros envían estos botones."
          }
        }
      }
    },
    "OpenCfMoto, version %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCfMoto, versión %@"
          }
        }
      }
    },
    "OpenRouteService API key": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave API de OpenRouteService"
          }
        }
      }
    },
    "OpenStreetMap copyright": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Derechos de autor de OpenStreetMap"
          }
        }
      }
    },
    "Pair your bike": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareja tu moto"
          }
        }
      }
    },
    "Paired: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparejada: %@"
          }
        }
      }
    },
    "Paired: %@ — tap Connect to reconnect": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparejada: %@ — toca Conectar para volver a conectar"
          }
        }
      }
    },
    "Park here": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estacionar aquí"
          }
        }
      }
    },
    "Parking": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estacionamiento"
          }
        }
      }
    },
    "Password": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraseña"
          }
        }
      }
    },
    "Password copied — it stays on this iPhone for 2 minutes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraseña copiada: se queda en este iPhone durante 2 minutos"
          }
        }
      }
    },
    "Password copied — paste it in Settings within 2 minutes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraseña copiada: pégala en Ajustes antes de 2 minutos"
          }
        }
      }
    },
    "Per-bike settings are saved for %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes por moto se guardan para %@."
          }
        }
      }
    },
    "Permissions": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permisos"
          }
        }
      }
    },
    "Phone media remote": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mando multimedia del teléfono"
          }
        }
      }
    },
    "Place actions": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acciones del lugar"
          }
        }
      }
    },
    "Pocket mode": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo bolsillo"
          }
        }
      }
    },
    "Pocket mode in %lld s": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo bolsillo en %lld s"
          }
        }
      }
    },
    "Pocket mode in %lld seconds. Put the phone away: the dash stays live.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo bolsillo en %lld segundos. Guarda el teléfono: el tablero sigue en vivo."
          }
        }
      }
    },
    "Point the camera at the bike's MotoPlay QR\n\nIf it won't scan — try the iOS / CarPlay QR, or enter Wi-Fi manually (TRK).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta la cámara al QR de MotoPlay de la moto\n\nSi no escanea, prueba con el QR de iOS/CarPlay o introduce el Wi-Fi manualmente (TRK)."
          }
        }
      }
    },
    "Portions © The Android Open Source Project and Material Icons by Google are licensed under the Apache License 2.0.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partes © The Android Open Source Project y los iconos Material de Google tienen licencia Apache 2.0."
