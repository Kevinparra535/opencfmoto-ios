    "Also read the dash's ▲/▼ by watching the phone volume. Each press really changes the volume and shows the volume indicator.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee también los ▲/▼ del tablero vigilando el volumen del teléfono. Cada pulsación cambia de verdad el volumen y muestra el indicador de volumen."
          }
        }
      }
    },
