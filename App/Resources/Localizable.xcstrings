    "Auto switches the dash map to dark at night and light by day. Map settings apply instantly, also while projecting.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto cambia el mapa del tablero a oscuro por la noche y claro durante el día. Los ajustes del mapa se aplican al instante, también mientras proyectas."
          }
        }
      }
    },
