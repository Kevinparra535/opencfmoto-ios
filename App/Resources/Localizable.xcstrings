{
  "sourceLanguage": "en",
  "strings": {
    "%@ lines": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ líneas"
          }
        }
      }
    },
    "%@ places": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lugares"
          }
        }
      }
    },
    "1. Copy the password.\n2. Open Settings, go back to the main list and tap Wi-Fi.\n3. Choose the bike's network and paste the password.\n4. Come back here — OpenCfMoto continues by itself, or tap “I've joined”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Copia la contraseña.\n2. Abre Ajustes, vuelve a la lista principal y toca Wi-Fi.\n3. Elige la red de la moto y pega la contraseña.\n4. Vuelve aquí: OpenCfMoto continúa solo, o toca «Ya me he conectado»."
          }
        }
      }
    },
    "1000 ms — slow doubles (long physical press)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1000 ms: dobles lentos (pulsación física larga)"
          }
        }
      }
    },
